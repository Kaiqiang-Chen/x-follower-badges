{
  "manifest_version": 3,
  "name": "X 粉丝数 · Follower Badges",
  "version": "1.1.3",
  "minimum_chrome_version": "111",
  "description": "在 X 时间线显示粉丝数，并通过原生菜单一键关注作者。无 API Key，不保存登录凭证。",
  "permissions": [
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "X 粉丝数"
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*",
        "https://www.x.com/*",
        "https://www.twitter.com/*"
      ],
      "js": [
        "interceptor.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*",
        "https://www.x.com/*",
        "https://www.twitter.com/*"
      ],
      "js": [
        "content.js",
        "follow.js"
      ],
      "css": [
        "badges.css"
      ],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ]
}
